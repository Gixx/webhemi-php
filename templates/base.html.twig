<!DOCTYPE html>
{# data-wh-theme: Admin Theme scope for @webhemi/ui CSS. Site surfaces override later (e.g. default). #}
<html lang="en" {% block html_attributes %}data-wh-theme="admin"{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}WebHemi{% endblock %}</title>
    <link rel="icon" href="{{ asset('admin/logo/webhemi.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('admin/index.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
