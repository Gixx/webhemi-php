{% extends 'base.html.twig' %}

{% block html_attributes %}data-wh-theme="default"{% endblock %}

{% block title %}Sign in — WebHemi{% endblock %}

{% block stylesheets %}
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 24rem; }
  label { display: block; margin-top: 0.75rem; }
  input[type="email"], input[type="password"] { width: 100%; padding: 0.4rem; }
  button { margin-top: 1rem; }
  .error { color: #a00; }
</style>
{% endblock %}

{% block body %}
<h1>Sign in</h1>
<p>Site account (separate from admin).</p>
{% if error %}
  <p class="error">{{ error }}</p>
{% endif %}
<form method="post" action="{{ path('frontend_login') }}">
  <label for="email">Email</label>
  <input id="email" type="email" name="email" value="{{ last_username }}" required autocomplete="username">

  <label for="password">Password</label>
  <input id="password" type="password" name="password" required autocomplete="current-password">

  <input type="hidden" name="_csrf_token" value="{{ csrf_token('frontend_authenticate') }}">
  <button type="submit">Sign in</button>
</form>
{% endblock %}
