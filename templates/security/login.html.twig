{% extends 'base.html.twig' %}

{% block title %}Sign in — WebHemi{% endblock %}

{% block body %}
{# Admin Theme paints the desktop; center the Win98 login dialog. #}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div {{ react_component('LoginPage', {
        action: path('app_login'),
        csrfToken: csrf_token('authenticate'),
        csrfFieldName: '_csrf_token',
        emailDefault: last_username,
        error: error
    }) }}></div>
</div>
{% endblock %}
